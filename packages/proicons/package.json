{
    "name": "proicons",
    "version": "4.13.0",
    "description": "A collection of 500+ modern and open-source icons",
    "keywords": [
        "feather",
        "fluent",
        "font awesome",
        "icon-library",
        "icon-pack",
        "icons",
        "js",
        "lucide",
        "procode",
        "proicons",
        "svg"
    ],
    "homepage": "https://github.com/ProCode-Software/proicons/tree/main/packages/proicons",
    "bugs": "https://github.com/ProCode-Software/proicons/issues",
    "license": "MIT",
    "author": "ProCode Software",
    "repository": {
        "url": "ProCode-Software/proicons"
    },
    "files": [
        "dist"
    ],
    "type": "module",
    "sideEffects": false,
    "main": "dist/cjs/proicons.cjs",
    "module": "dist/esm/proicons.js",
    "browser": "dist/umd/proicons.cjs",
    "typings": "dist/types/proicons.d.ts",
    "unpkg": "dist/umd/proicons.cjs",
    "jsdelivr": "dist/umd/proicons.cjs",
    "exports": {
        ".": {
            "types": "./dist/types/proicons.d.ts",
            "import": "./dist/esm/proicons.js",
            "require": "./dist/cjs/proicons.cjs",
            "default": "./dist/umd/proicons.cjs"
        }
    },
    "publishConfig": {
        "access": "public"
    },
    "scripts": {
        "dev": "bun vite",
        "build": "bun vite build && bunx tsc",
        "icons:build-modules": "bun run ../../bin/addIconFiles.ts -t './bin/iconTemplate.ts' --out './src/icons' -i './src/icons.ts' -d --format ts --clean",
        "ci": "pnpm run icons:build-modules && pnpm run build"
    },
    "devDependencies": {
        "@proicons/shared": "workspace:*",
        "@types/bun": "latest",
        "typescript": "^7.0.2",
        "vite": "catalog:"
    },
    "amdName": "proicons",
    "main:umd": "dist/umd/proicons.cjs"
}
